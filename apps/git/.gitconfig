# Refuse to commit where no account is assigned, so neither the personal nor the work identity leaks.
[user]
	useConfigOnly = true
[includeIf "gitdir:~/dotfiles/"]
	path = ~/dotfiles/apps/git/dotfiles.gitconfig
[core]
	editor = vim
	autoCRLF = false
[init]
  defaultBranch = main
[pull]
	rebase = false
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
# Machine-specific settings (not in dotfiles). Keep this last so it overrides the above.
[include]
	path = ~/.gitconfig.local
