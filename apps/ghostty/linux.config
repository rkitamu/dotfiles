# Linux 用 (config から config.os として読み込まれる)
# Cica: https://github.com/miiton/Cica (~/.local/share/fonts に配置)
# 日本語は Cica に含まれる。Noto は Cica に無い字のフォールバック
font-family = "Cica"
font-family = "Noto Sans CJK JP"
adjust-cell-height = 10%

# ウィンドウ (GTK)
gtk-titlebar = true
gtk-tabs-location = top
gtk-wide-tabs = false
