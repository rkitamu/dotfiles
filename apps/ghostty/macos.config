# macOS 用 (config から config.os として読み込まれる)
font-family = "JetBrainsMonoNL Nerd Font Mono"
font-family = "Hiragino Kaku Gothic ProN"
adjust-cell-height = -10%
font-thicken = true

# Option を Alt として扱う (herdr / readline の Meta 用。特殊文字入力は不可になる)
macos-option-as-alt = true

# NOTE: herdr のペインでは、Claude Code が起動後にキーボード拡張モードを失うと Shift+Enter が Enter として届き送信されてしまう
# （herdrdev/herdr#5660）。ESC+CR（Option+Enter と同じ）はモードに関係なく改行として届くので、Shift+Enter をこれに置き換える。
# issue が直ったら消す。
keybind = shift+enter=text:\x1b\r
