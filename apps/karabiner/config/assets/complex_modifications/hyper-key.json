{
  "title": "Hyper キー",
  "rules": [
    {
      "description": "右Option: 単押しで Option、他キーと同時押しで Hyper (Ctrl+Option+Cmd+Shift)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_option",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": ["left_command", "left_control", "left_option"]
            }
          ],
          "to_if_alone": [{ "key_code": "right_option" }]
        }
      ]
    }
  ]
}
